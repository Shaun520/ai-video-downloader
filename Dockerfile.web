# syntax=docker/dockerfile:1
# SaveAny Web（融合形态：Next.js + yt-dlp + ffmpeg 单容器）
# 目标平台：腾讯云 CloudBase 云托管（上海地域）
#
# CloudBase 服务配置（新建服务时）：
#   - 部署方式：上传代码包（上传整个仓库，压缩包不要多包一层顶层文件夹）
#   - Dockerfile 名称：Dockerfile.web   （目标目录留空 / 不填）
#   - 端口：3000
#   - 容器规格：建议 1核2G 起（ffmpeg 合并视频吃内存）
#   - 实例数：最小 1（避免缩容到 0，Next.js 冷启动慢）
#
# 本地验证：docker build -f Dockerfile.web -t saveany-web .
#           docker run --env PORT=3000 -p 3000:3000 saveany-web
#
# ⚠️ NEXT_PUBLIC_* 会被 Next.js 在构建期内联进产物，必须在构建阶段注入：
#    方法一（推荐）：云托管控制台「构建参数 / 构建环境变量」里传下面三个 ARG；
#    方法二：直接把真实值写进下方的 ARG 默认值（三者均为公开值，无泄露风险）。
#    漏配会导致页面拿不到 Supabase URL/anon key、支付回调指向 localhost。

# ---------- 运行时基础镜像：node + ffmpeg + yt-dlp ----------
FROM node:22-slim AS base
# ffmpeg：音视频合并；python3/pip + yt-dlp[default]：解析/下载
# （[default] 自带 curl_cffi 浏览器指纹伪装，TikTok 等平台提取器依赖它过反爬壳）
RUN apt-get update \
  && apt-get install -y --no-install-recommends ffmpeg python3 python3-pip \
  && rm -rf /var/lib/apt/lists/* \
  && pip3 install --no-cache-dir --break-system-packages -U "yt-dlp[default]" \
  && yt-dlp --version
WORKDIR /app

# ---------- 构建阶段 ----------
FROM base AS build

# 构建期内联变量（必填，见文件头说明）
ARG NEXT_PUBLIC_SUPABASE_URL=https://zwadisymylqberhsftmp.supabase.co
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inp3YWRpc3lteWxxYmVyaHNmdG1wIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODkzNTUxOTksImV4cCI6MjEwNDkzMTE5OX0.xoaqNp6wBBRsRfmX8qLyVGQMCVP_nfPtYxm9MmgA15k
ARG NEXT_PUBLIC_APP_URL=http://localhost:3311
ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL \
    NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY \
    NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL \
    NEXT_TELEMETRY_DISABLED=1

# 仅复制构建所需内容，缩小构建上下文
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json turbo.json ./
COPY packages ./packages
COPY apps/web ./apps/web

RUN npm install -g pnpm@10
# 安装 web 及其 workspace 依赖（shared/core/db）的依赖树
RUN pnpm install --filter web... --no-frozen-lockfile
# turbo 按依赖顺序构建：shared -> core/db -> web(next build)
RUN pnpm exec turbo build --filter=web

# ---------- 运行阶段 ----------
FROM base AS runtime
ENV NODE_ENV=production \
    PORT=3000 \
    CONTAINER_URL="" \
    NEXT_TELEMETRY_DISABLED=1
# CONTAINER_URL 留空 = 本地直跑 yt-dlp/ffmpeg（融合形态核心）

WORKDIR /app
# 复制 pnpm 安装产物（.pnpm store + workspace 链接）与各包
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages ./packages
COPY --from=build /app/apps/web ./apps/web
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/pnpm-workspace.yaml ./pnpm-workspace.yaml

EXPOSE 3000
CMD ["sh", "-c", "cd apps/web && exec node node_modules/next/dist/bin/next start -p $PORT"]